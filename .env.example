# Nansen
NANSEN_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# 任意: モデル文字列の差し替え用。未設定なら現行 Sonnet (claude-sonnet-4-6) を使用
ANTHROPIC_MODEL=claude-sonnet-4-6

# x402 v2 ファシリテーター (CDP / Coinbase)
# CDP の API キーを入れると本番ファシリテーターを使用。未設定なら公開 CDP エンドポイント。
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# 任意: ファシリテーターURLの明示指定（CDPキー未設定時のみ使用）
FACILITATOR_URL=

# EVM受取ウォレット (Base / Polygon)
WALLET_ADDRESS=

# Solana受取ウォレット
SOLANA_WALLET_ADDRESS=

# Solana RPC
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxx

# JPYC (Polygon)
JPYC_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_JPYC_CONTRACT=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BF

# Vercel KV
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Mode A Gate (agent/mode-a)
# Hyperliquid divergenceScore のしきい値 (0.0–1.0)。これ以上のトークンのみ Decoder を発火。
HL_DIVERGENCE_MIN_SCORE=0.75
